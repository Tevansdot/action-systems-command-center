# Without Supabase credentials the login screen offers an isolated demo workspace.
# To disable demo mode explicitly, set DEMO_MODE=false.
DEMO_MODE=auto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase anon keys are also accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Set directly on your hosting provider, never in browser variables.
OPENAI_API_KEY=
# Alternative for cloud environments that reserve OPENAI_* variable names:
ACTION_SYSTEMS_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: stable server-only demo signing secret (at least 32 characters).
# Local development otherwise persists a generated key in ignored .local/.
COMMAND_CENTER_SESSION_SECRET=
# Set to an exact HTTPS origin in production. Demo data is local, not cloud storage.
APP_ORIGIN=http://localhost:3000
